{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "package",
            "description": "公開するパッケージを選択してください",
            "type": "pickString",
            "options": [
                {
                    "value": "annotations"
                },
                {
                    "value": "lint"
                }
            ]
        },
        {
            "id": "dryRun",
            "description": "dry-run の有無を選択してください",
            "type": "pickString",
            "default": "--dry-run",
            "options": [
                {
                    "label": "dry-run（検証のみ）",
                    "value": "--dry-run"
                },
                {
                    "label": "本番公開",
                    "value": ""
                }
            ]
        }
    ],
    "tasks": [
        {
            "type": "shell",
            "label": "[layered] format",
            "command": "mise",
            "args": [
                "run",
                "fla:format"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "[layered] analyze",
            "command": "mise",
            "args": [
                "run",
                "fla:analyze"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "[layered] test",
            "command": "mise",
            "args": [
                "run",
                "fla:test"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "[layered] mise run fla:publish",
            "type": "shell",
            "command": "mise run fla:publish ${input:package} ${input:dryRun}",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
